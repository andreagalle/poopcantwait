{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "meshy"
  ],
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm view *)",
      "Bash(npm ls *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx gltf-transform *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git stash*)",
      "Bash(git restore *)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh issue *)",
      "WebFetch(domain:developer.playcanvas.com)",
      "WebFetch(domain:api.playcanvas.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.meshy.ai)",
      "WebFetch(domain:openrouter.ai)",
      "WebFetch(domain:gltf-transform.dev)",
      "mcp__meshy__meshy_check_balance",
      "mcp__meshy__meshy_get_task_status",
      "mcp__meshy__meshy_list_tasks",
      "mcp__meshy__meshy_list_models",
      "mcp__meshy__meshy_list_animations",
      "mcp__meshy__meshy_download_model"
    ],
    "ask": [
      "mcp__meshy__meshy_text_to_3d",
      "mcp__meshy__meshy_text_to_3d_refine",
      "mcp__meshy__meshy_image_to_3d",
      "mcp__meshy__meshy_multi_image_to_3d",
      "mcp__meshy__meshy_remesh",
      "mcp__meshy__meshy_retexture",
      "mcp__meshy__meshy_rig",
      "mcp__meshy__meshy_animate",
      "mcp__meshy__meshy_text_to_motion",
      "mcp__meshy__meshy_uv_unwrap",
      "mcp__meshy__meshy_resize",
      "mcp__meshy__meshy_convert",
      "mcp__meshy__meshy_text_to_image",
      "mcp__meshy__meshy_image_to_image",
      "Bash(npm run assets:image *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.github/workflows/**)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.mcp.json)",
      "Edit(./.devcontainer/**)",
      "mcp__meshy__meshy_cancel_task",
      "mcp__meshy__meshy_creative_lab",
      "mcp__meshy__meshy_send_to_slicer",
      "mcp__meshy__meshy_process_multicolor",
      "mcp__meshy__meshy_repair_printability",
      "mcp__meshy__meshy_auto_split"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"
            ],
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Checking repository policy"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"
            ],
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Checking repository policy"
          }
        ]
      }
    ]
  }
}
