{
    "name": "gotta-go",
    "version": "0.1.0",
    "private": true,
    "description": "Gotta Go! A 3D arcade game for the browser, built with the PlayCanvas Engine",
    "type": "module",
    "scripts": {
        "assets:image": "node -e \"console.error('assets:image is implemented in M6'); process.exit(1)\"",
        "assets:optimize": "node -e \"console.error('assets:optimize is implemented in M6'); process.exit(1)\"",
        "build": "vite build",
        "check": "npm run typecheck && npm run lint && npm run fmt && npm run test",
        "dev": "vite",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "vite preview",
        "test": "vitest run --coverage",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
    },
    "dependencies": {
        "playcanvas": "^2.23.3"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0",
        "@playcanvas/inspector": "^0.4.0",
        "@playwright/test": "^1.65.0",
        "@types/node": "^24.19.2",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^9.39.5",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
