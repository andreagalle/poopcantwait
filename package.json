{
    "name": "gotta-go",
    "version": "0.2.0",
    "private": true,
    "description": "Gotta Go! A 3D arcade game for the browser, built with the PlayCanvas Engine",
    "type": "module",
    "scripts": {
        "assets:image": "node scripts/assets/gen-image.mjs",
        "assets:optimize": "node scripts/assets/optimize.mjs",
        "build": "vite build -c site/vite.config.ts && vite build",
        "check": "npm run typecheck && npm run lint && npm run fmt && npm run test",
        "dev": "vite",
        "dev:site": "vite -c site/vite.config.ts",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "vite preview -c site/vite.config.ts",
        "story:shot": "node scripts/site/shot.mjs",
        "story:stats": "node scripts/site/story-stats.mjs",
        "test": "vitest run --coverage",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
    },
    "dependencies": {
        "playcanvas": "^2.23.3"
    },
    "devDependencies": {
        "@gltf-transform/cli": "^4.5.1",
        "@gltf-transform/core": "^4.5.1",
        "@gltf-transform/extensions": "^4.5.1",
        "@gltf-transform/functions": "^4.5.1",
        "@playcanvas/eslint-config": "3.0.0",
        "@playcanvas/inspector": "^0.4.0",
        "@playwright/test": "^1.65.0",
        "@types/node": "^24.19.2",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^9.39.5",
        "meshoptimizer": "^1.3.0",
        "prettier": "^3.9.10",
        "sharp": "^0.35.5",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
